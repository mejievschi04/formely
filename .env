# ===========================================
# Formely - Variabile pentru Docker/VPS
# Copiază în .env și completează valorile
# ===========================================

# --- Aplicație (local – pentru producție vezi MIGRARE_VPS.md) ---
APP_NAME="Formely"
APP_ENV=local
APP_KEY=base64:xYMIerl7ev1DJF/PgudKbOv3K6SC4KBK3qYo1oVJL7E=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
DB_PORT=5432
DB_DATABASE=formely
DB_USERNAME=postgres
DB_PASSWORD=1111

# --- Porturi expuse (schimbă dacă sunt ocupate de alte servicii) ---
BACKEND_PORT=8000
FRONTEND_PORT=3001

# --- Session ---
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Frontend URL (pentru CORS) – Vite dev:5173 / Docker frontend:3001 ---
FRONTEND_URL=http://localhost:5173,http://localhost:3001

# --- API URL pentru build frontend (Vite) ---
# Local: php artisan serve sau nginx-backend din Docker pe 8000
VITE_API_URL=http://localhost:8000/api

# --- AI Provider (opțional) ---
AI_PROVIDER=groq
AI_EMBEDDING_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CREATOR_MODEL=llama-3.1-8b-instant
GROQ_CREATOR_QUALITY_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# --- Logging ---
LOG_LEVEL=debug