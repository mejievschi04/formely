# Template pentru variabile de mediu - Frontend
# Copiază acest conținut într-un fișier .env în frontend/

# API Configuration
# Pe VPS (academy.formely.org): /api — Nginx din container proxiază către backend.
VITE_API_URL=/api
VITE_API_TIMEOUT=10000
VITE_UPLOAD_TIMEOUT=600000

# Backoffice (platform operators)
VITE_BACKOFFICE_URL=https://admin.formely.org

# Storage — pe VPS lasă gol (same-origin /storage via proxy)
# Local: VITE_STORAGE_URL=http://localhost:8000
# VITE_STORAGE_URL=

# Application Environment
VITE_APP_ENV=production
