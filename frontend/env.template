# Template pentru variabile de mediu - Frontend
# Copiază acest conținut într-un fișier .env în frontend/

# API Configuration
# Același host ca SPA: /api (recomandat pe VPS). URL absolut doar dacă API e pe alt domeniu.
VITE_API_URL=/api
VITE_API_TIMEOUT=10000
VITE_UPLOAD_TIMEOUT=600000

# Storage URL – unde se servesc imaginile (backend). Obligatoriu când frontend ≠ backend.
# Local: VITE_STORAGE_URL=http://localhost:8000
# Producție (același domeniu): lasă necomentat
# VITE_STORAGE_URL=http://localhost:8000

# Application Environment
VITE_APP_ENV=production
