# Copiază în deploy.env (nu se comite în git) — folosit de scripts/deploy-remote.ps1
# Deploy de pe Windows/Mac: codul merge pe GitHub, VPS face pull + docker compose automat.

# Adresa VPS (IP sau domeniu SSH)
VPS_HOST=195.178.106.107

# Utilizator SSH (ex. root sau deploy)
VPS_USER=root

# Calea proiectului pe VPS (unde există docker-compose.yml și .env)
VPS_PATH=/opt/Formely

# Opțional: cheie SSH (ex. C:\Users\User\.ssh\id_ed25519)
# VPS_SSH_KEY=

# Branch Git pe server (implicit main)
# VPS_GIT_BRANCH=main
