# Formely Backend – variabile de mediu
# Copiază: cp .env.example .env și completează valorile.
# Vezi și env.template pentru același conținut.

APP_NAME="Formely"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Bucharest

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (ex.: PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=formely
DB_USERNAME=formely_user
DB_PASSWORD=formely_password
DB_SSLMODE=prefer

# Session (cookie sesiune + XSRF)
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Producție HTTPS: true (sau lasă gol — devine true automat când APP_URL e https://)
SESSION_SECURE_COOKIE=
# lax = același site (ex. SPA și API pe același host, / și /api). Cross-subdomenii diferite → uneori none + Secure
SESSION_SAME_SITE=lax
# Gol = hostul exact din browser (recomandat). Nu seta domeniu fix dacă folosești www și non-www.
SESSION_DOMAIN=

# CORS – origini frontend (virgulă). Prima valoare = LMS (linkuri invitație / reset parolă).
FRONTEND_URL=http://localhost:5173,http://localhost:4321,http://localhost:5180,http://127.0.0.1:4321,http://127.0.0.1:5180
FORMELY_BACKOFFICE_URL=http://localhost:5180

# Sales-led: register public off (conturi prin invitație). true doar pentru sandbox demo.
FORMELY_PUBLIC_REGISTER_ENABLED=false

# Invitații utilizatori (zile până expiră linkul din email)
INVITATION_EXPIRE_DAYS=7

# Multi-tenant: slug companie implicită (date existente + branding login)
FORMELY_DEFAULT_COMPANY_SLUG=default

# Sanctum SPA: hosturi fără https:// (opțional port). Hosturile din APP_URL și FRONTEND_URL se adaugă automat la listă.
# Producție explicit: localhost,www.localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:4321,localhost:5180,127.0.0.1,127.0.0.1:4321,127.0.0.1:5180

# AI (ollama|openai|huggingface|groq)
# După `php artisan config:cache`, cheile AI se citesc din config/ai.php — păstrează GROQ_* / OPENAI_* în .env.
AI_PROVIDER=ollama

# Groq (opțional, dacă AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CREATOR_MODEL=llama-3.1-8b-instant
GROQ_CREATOR_QUALITY_MODEL=llama-3.3-70b-versatile
# Fallback chain: dacă modelul curent e limitat/ocupat, se încearcă pe rând următoarele.
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

OLLAMA_API_KEY=
OLLAMA_API_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma:2b-instruct
# Optional: model dedicat pentru creator (recomandat >= 7B pentru coerență bună)
OLLAMA_CREATOR_MODEL=gemma:2b-instruct
# Optional: model pentru creator când user cere explicit "calitate maximă"
OLLAMA_CREATOR_QUALITY_MODEL=qwen2.5:7b-instruct
# Optional: model dedicat pentru tutor AI
OLLAMA_TUTOR_MODEL=gemma:2b-instruct
# true doar dacă backend-ul are suficienți workeri (ex: php-fpm), altfel poate bloca alte request-uri
AI_TUTOR_DIRECT_STREAM=false
# Timeouts AI (secunde)
AI_CONNECT_TIMEOUT=15
AI_REQUEST_TIMEOUT=180
AI_TUTOR_TIMEOUT=120
# 0 = fără timeout pentru guided_creation
AI_GUIDED_CREATION_TIMEOUT=0
# Max tokens pentru generarea ghidată de curs (JSON mare: module + lecții + HTML).
# Sub ~4000 apare des JSON trunchiat / validare eșuată. 8192 e un default rezonabil pentru Groq/OpenAI.
AI_GUIDED_MAX_TOKENS=8192
# Prag minim linii de conținut per lecție (după strip HTML). Crește dacă vrei lecții mai lungi.
AI_MIN_LESSON_LINES=11
AI_VERIFY_SSL=true

# Mesagerie — rate limit (după config:cache se citesc din config/messages.php)
# FORMELY_MESSAGES_READ_PER_MINUTE=2000
# FORMELY_MESSAGES_WRITE_PER_MINUTE=180

# Mail — până la SMTP lasă log. Lead-urile tot apar în /admin/platform.
# Invitațiile: copiază linkul din consolă / ieșirea formely:provision-company.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Notificări lead (email intern). Gol = fără mail, doar DB.
FORMELY_LEADS_NOTIFY_EMAIL=
# URL LMS pentru linkuri invitație / reset (override față de primul FRONTEND_URL)
FORMELY_LMS_URL=
# Producție: https://academy.formely.org
# FORMELY_BACKOFFICE_URL=https://admin.formely.org
# APP_URL=https://api.formely.org
# FRONTEND_URL=https://academy.formely.org,https://admin.formely.org,https://formely.org
# SANCTUM_STATEFUL_DOMAINS=academy.formely.org,admin.formely.org,formely.org,api.formely.org

# Demo academie (zile) când status=trial
FORMELY_TRIAL_DAYS=15

# Platform operator (ProductionSeeder)
FORMELY_PLATFORM_OPERATOR_EMAIL=platform@formely.local
FORMELY_PLATFORM_OPERATOR_NAME="Platform Admin"
# Obligatoriu în production: php artisan db:seed --class=ProductionSeeder
FORMELY_PLATFORM_OPERATOR_PASSWORD=

CACHE_STORE=file
# Producție: database (sau redis). sync blochează request-urile pe mail.
QUEUE_CONNECTION=sync
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Bibliotecă — coperta primei pagini la upload vine din browser (PDF.js); nu e obligatoriu.
# Opțional pe server (regenerare CLI / fallback): Ghostscript sau Imagick.
# LIBRARY_PDF_GS="C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe"
# LIBRARY_PDF_GS=
