# Template pentru variabile de mediu - Backend
# Copiază acest conținut într-un fișier .env în backend/

APP_NAME="Formely"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=formely
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_SSLMODE=prefer

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Gol = cookie pentru hostul exact din browser (recomandat). Nu pune domeniu fix dacă folosești și www.
SESSION_DOMAIN=

# CORS Configuration - Frontend URL (poate fi multiplu, separați cu virgulă)
FRONTEND_URL=https://localhost
FORMELY_BACKOFFICE_URL=https://backoffice.localhost
FORMELY_LMS_URL=https://localhost
FORMELY_PUBLIC_REGISTER_ENABLED=false
FORMELY_LEADS_NOTIFY_EMAIL=ops@localhost
FORMELY_TRIAL_DAYS=15
FORMELY_DEFAULT_COMPANY_SLUG=default
FORMELY_PLATFORM_OPERATOR_EMAIL=platform@formely.local
FORMELY_PLATFORM_OPERATOR_NAME="Platform Admin"
FORMELY_PLATFORM_OPERATOR_PASSWORD=

# AI Provider Configuration (openai|huggingface|groq)
AI_PROVIDER=groq
AI_EMBEDDING_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CREATOR_MODEL=llama-3.1-8b-instant
GROQ_CREATOR_QUALITY_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile

# Alternative AI Providers (optional)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

HUGGINGFACE_API_KEY=
HUGGINGFACE_API_URL=https://router.huggingface.co
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# SSL Verification
AI_VERIFY_SSL=true

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Cache Configuration
CACHE_STORE=file
CACHE_PREFIX=

# Queue Configuration (database recommended in Docker without Redis)
QUEUE_CONNECTION=database

# Filesystem Configuration
FILESYSTEM_DISK=local
