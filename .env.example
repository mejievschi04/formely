# =============================================================================
# Formely — producție VPS (Docker)
# Copiază: cp .env.example .env && nano .env
# Deploy:   ./scripts/deploy-vps.sh
# Docs:     docs/DEPLOY.md
#
# Domenii:
#   formely.org          → website
#   api.formely.org      → Laravel API
#   academy.formely.org  → LMS (frontend)
#   admin.formely.org    → backoffice platformă
# =============================================================================

# --- App ---
APP_NAME=Formely
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Generează: docker compose -f docker-compose.yml -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
APP_URL=https://api.formely.org
APP_TIMEZONE=Europe/Bucharest
LOG_LEVEL=error

# --- PostgreSQL (container Docker, izolat) ---
DB_DATABASE=formely
DB_USERNAME=formely_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_SSLMODE=prefer
# În producție Postgres Formely NU se publică pe host (nu folosește 5432 pe VPS).
# Backend se conectează intern la hostul Docker `postgres:5432`.
# Dacă rulezi compose FĂRĂ prod.yml (debug), publică pe:
# DB_PUBLISH_PORT=15432

# --- Sesiuni / cookie (HTTPS) ---
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Gol = cookie pe hostul SPA (academy / admin, via proxy /api). Nu seta .formely.org decât dacă știi de ce.
SESSION_DOMAIN=

# --- CORS + linkuri ---
# Toate originile SPA / site care apelează API (virgulă, fără spații inutile)
FRONTEND_URL=https://academy.formely.org,https://admin.formely.org,https://formely.org,https://www.formely.org
FORMELY_LMS_URL=https://academy.formely.org
FORMELY_BACKOFFICE_URL=https://admin.formely.org
SANCTUM_STATEFUL_DOMAINS=academy.formely.org,admin.formely.org,formely.org,www.formely.org,api.formely.org

# --- Sales-led ---
FORMELY_PUBLIC_REGISTER_ENABLED=false
FORMELY_TRIAL_DAYS=15
FORMELY_LEADS_NOTIFY_EMAIL=ops@formely.org

# --- Platform operator (ProductionSeeder) ---
FORMELY_PLATFORM_OPERATOR_EMAIL=platform@formely.org
FORMELY_PLATFORM_OPERATOR_NAME="Platform Admin"
FORMELY_PLATFORM_OPERATOR_PASSWORD=CHANGE_ME_STRONG_OPERATOR_PASSWORD

# --- Queue / mail ---
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@formely.org
MAIL_FROM_NAME=Formely

# --- AI (opțional) ---
AI_PROVIDER=groq
GROQ_API_KEY=

# --- Vite build args (baked la docker build) ---
VITE_API_URL=/api
VITE_BACKOFFICE_URL=https://admin.formely.org
VITE_APP_ENV=production
VITE_SITE_URL=https://formely.org
VITE_APP_URL=https://academy.formely.org
# Website → API absolut (lead form)
VITE_WEBSITE_API_URL=https://api.formely.org
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=

# --- Porturi localhost (prod — Nginx pe host proxiază aici) ---
# Evită 8000/8080 dacă sunt folosite de alte proiecte pe VPS.
BACKEND_PORT=18080
FRONTEND_PORT=13001
WEBSITE_PORT=14322
BACKOFFICE_PORT=15181
# DB_PORT / DB_PUBLISH_PORT — în prod Postgres e doar intern (fără port pe host)
