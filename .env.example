# Formely – setup local (monorepo)
#
# Backend:  cp backend/.env.example backend/.env  → php artisan key:generate
# Frontend: cp frontend/env.template frontend/.env
#
# PostgreSQL (exemplu):
#   DB_DATABASE=formely
#   DB_USERNAME=formely_user
#   DB_PASSWORD=formely_password
#
# Creare DB (o dată, ca superuser local):
#   createdb -h 127.0.0.1 -U "$(whoami)" -O formely_user formely
#
# Migrări: cd backend && php artisan migrate
